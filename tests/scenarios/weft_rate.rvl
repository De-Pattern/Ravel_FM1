# WEFT RATE: HALF runs the patch at half the rate. Every factory patch still sounds at HALF (a few
# here: a saw through a low pass, the FM bell, the plucked string, the feedback loops), and FULL again as before
wait 300
kind 1 6
wset 1 11 0 1
key 12 down
wait 400
expect meter_min 1 0.01
key 12 up
wait 1500
expect wvoices 0
wpreset 1 2
wset 1 11 0 1
key 12 down
wait 300
expect meter_min 1 0.005
key 12 up
wait 600
wpreset 1 18
wset 1 11 0 1
key 12 down
wait 300
expect meter_min 1 0.005
key 12 up
wait 600
wpreset 1 27
wset 1 11 0 1
wset 1 10 0 1
wait 1500
expect meter_min 1 0.001
wset 1 11 0 0
wait 500
expect meter_min 1 0.001
