# HYBRID FM: T1 turned to it on SOUND gets its further settings' defaults (MOD SUS 32, the formants off);
# the factory sounds with formants sound; a formant sequence and MOD ATK play; the pages are there
wait 300
tap EDIT
wait 200
expect page SOUND
turn K2 1
wait 80
turn K2 1
wait 120
expect tp 1 ENGINE 2
expect tp 1 MOD_SUS 32
expect tp 1 FORM 0
expect tp 1 F_DEPTH 127
key 12 down
wait 400
expect meter_min 1 0.005
key 12 up
wait 600
turn SELECT 5
wait 200
expect page MOD ENV
turn SELECT 1
wait 200
expect page FORMANTS
turn SELECT 1
wait 200
expect page FSEQ
preset 1 14
wait 50
expect tp 1 FORM 2
expect tp 1 FSEQ 2
key 12 down
wait 800
expect meter_min 1 0.005
key 12 up
wait 800
preset 1 18
key 12 down
key 16 down
wait 1500
expect meter_min 1 0.005
key 12 up
key 16 up
wait 1500
preset 1 19
settp 1 F_RATE 0
settp 1 MORPH 60
key 12 down
wait 400
expect meter_min 1 0.003
key 12 up
wait 400
settp 1 MOD_ATK 100
settp 1 FORM 6
settp 1 AIR 127
settp 1 FSEQ 6
settp 1 F_RATE 7
key 12 down
wait 900
expect meter_min 1 0.003
key 12 up
wait 300
