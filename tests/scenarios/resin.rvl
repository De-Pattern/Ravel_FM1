# RESIN: the bowed string and the reed both speak, QUAKE pushes them, the presets load;
# the CPU meter shows when the platform reports a load
wait 300
tap EDIT
wait 200
expect page SOUND
turn K2 20
wait 200
expect tp 1 ENGINE 12
wav resin.wav
key 12 down
wait 1200
expect voices 1
expect peak_db_min -30
shot resin_bow.png
key 12 up
wait 600
turn SELECT 1
wait 200
shot resin_src.png
turn K1 1
wait 200
expect tp 1 MODEL 1
key 7 down
wait 1200
expect peak_db_min -30
key 7 up
wait 600
cpu 63
wait 100
shot resin_cpu.png
cpu 0
wavstop
