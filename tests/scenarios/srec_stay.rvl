# STEP REC on SEQ > DIRECTION: STAY keeps the cursor where it is, so the keys audition and write notes
# into the step PRESETS picks (note input); kept through power-off; NEXT moves on again
wait 300
tap SEQ
wait 100
turn SELECT 1
wait 60
turn SELECT 1
wait 60
turn SELECT 1
wait 60
turn SELECT 1
wait 60
turn SELECT 1
wait 60
turn SELECT 1
wait 60
wait 100
expect page DIRECTION
turn K2 1
wait 1500
reboot
wait 300
tap SEQ
wait 100
expect page STEPS
tap REC
wait 100
expect sreccur 1
key 0 down
wait 60
key 0 up
wait 100
expect sreccur 1
expect stepnote 1 1 53
key 2 down
wait 60
key 2 up
wait 100
expect sreccur 1
expect stepnote 1 1 55
turn PRESET 1
wait 100
expect sreccur 2
key 4 down
wait 60
key 4 up
wait 100
expect sreccur 2
expect stepnote 1 2 57
tap REC
wait 100
turn SELECT 1
wait 60
turn SELECT 1
wait 60
turn SELECT 1
wait 60
turn SELECT 1
wait 60
turn SELECT 1
wait 60
turn SELECT 1
wait 60
wait 100
expect page DIRECTION
turn K2 -1
wait 300
turn SELECT -20
wait 100
tap REC
wait 100
expect sreccur 3
key 7 down
wait 60
key 7 up
wait 100
expect sreccur 4
