# ENV > SHAPE: picking a shape keeps you on the SHAPE page (the classic pages hide); SHAPE 3's BEND,
# REVERSE, REPEAT and PHASE; a note plays through it
wait 300
tap ENV
turn SELECT -20
turn SELECT 4
wait 100
expect page SHAPE
turn K1 1
wait 200
expect page SHAPE
turn SELECT 2
wait 100
expect page SHAPE 3
turn K1 1
wait 200
turn K2 1
wait 200
turn K3 1
wait 200
turn K4 1
wait 200
expect tp 1 BEND 1
expect tp 1 REVERSE 1
expect tp 1 REPEAT 1
expect tp 1 PHASE 1
key 12 down
wait 400
expect voices 1
shot shape3.png
key 12 up
wait 300
