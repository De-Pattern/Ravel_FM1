# WEFT: T1 becomes a patched voice; its pages, its factory patches (each sounds), patching a block
# by hand, and the voice ending once let go
wait 300
kind 1 6
tap EDIT
turn SELECT -20
wait 100
expect page SOUND
expect tp 1 KIND 6
turn SELECT 1
wait 100
expect page WEFT PLAY
expect wtype 1 1 2
expect wtype 1 4 10
key 12 down
wait 400
expect meter_min 1 0.01
expect wvoices 1
key 12 up
wait 1500
expect wvoices 0
