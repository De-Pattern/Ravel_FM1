# GLITCH LOOPER (TEST build): T8 becomes a LOOP track; black key 1 records lane 1 from the main mix (the demo
# playing) and plays it back; LOOPER +SPACE and OFF; a white key holds a slice; on SEQ, trigs and ranges go on the steps
wait 300
demo 1
wait 200
tap PLAY
wait 1500
kind 8 5
wait 100
expect tp 8 KIND 5
turn ALGO 7
wait 100
tap EDIT
wait 150
expect page SOUND
turn SELECT 1
wait 150
expect page GLITCH LEVEL
tapkey 1
wait 100
expect loopst 1 3
wait 2500
tapkey 1
wait 100
expect loopst 1 1
expect loopfill 1 2000
wait 600
shot loop.png
expect meter_min 8 0.01
key 0 down
wait 300
expect loopst 1 9
key 0 up
wait 100
expect loopst 1 1
tap SEQ
wait 150
expect page GLITCH TRIGS
tapkey 7
wait 100
expect stepbits 8 5 1
key 7 down
wait 50
tapkey 18
wait 50
key 7 up
wait 100
expect lprange 8 5 1 7
# held on the right, tapped on the left: the section starts on the left (8-14), the trig there; the
# held step gets none, and a trig inside (step 10) goes
tapkey 16
wait 50
expect stepbits 8 10 1
key 23 down
wait 50
tapkey 12
wait 50
key 23 up
wait 100
expect stepbits 8 8 1
expect lprange 8 8 1 7
expect stepnote 8 14 -1
expect stepnote 8 10 -1
shot loopseq.png
# LOOPER +SPACE: the lanes start again, smaller; SPACE runs on and is recorded with the mix
settp 8 LOOPER 2
wait 100
expect loopst 1 0
tap EDIT
wait 150
tapkey 1
wait 1500
tapkey 1
wait 100
expect loopst 1 1
expect loopfill 1 1500
# LOOPER OFF: silent, the keys do nothing, the effects have their memory back
settp 8 LOOPER 0
wait 100
expect loopst 1 0
tapkey 1
wait 300
expect loopst 1 0
settp 8 LOOPER 1
wait 100
# KIND on SOUND, EDIT's first page, turns it back (it has trigs: turned twice; here T8: down to COMP,
# then PERC)
turn SELECT -20
wait 150
expect page SOUND
turn K1 -1
wait 300
expect tp 8 KIND 5
turn K1 -1
wait 300
expect tp 8 KIND 4
turn K1 -1
wait 300
expect tp 8 KIND 3
kind 8 0
wait 200
expect tp 8 KIND 0
