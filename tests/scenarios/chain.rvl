# CHAIN (a kit's): each lane's cords set off lanes a step later at their chance; MODE on the kit's TRACK page
wait 300
tap HOME
turn SELECT -20
turn K3 1
wait 100
turn K3 1
wait 200
expect tp 1 KIND 3
clear 1
tap SEQ
wait 150
turn SELECT 5
wait 150
expect page TRACK
turn K1 1
wait 100
expect tp 1 SEQMODE 3
turn SELECT -20
wait 150
expect page CHAIN
shot chain.png
# the factory chain plays (the steps are empty)
tap PLAY
wait 300
ons 0
wait 2000
expect ons 1 8 60
# no cords: the start lane at the top of each loop (16 steps, 2 s)
chainclear 1
wait 100
ons 0
wait 4000
expect ons 1 1 3
# the kick sets itself off every step: CORD 1 TO itself, CHANCE 100
turn K3 1
wait 60
expect page CHAIN
turn K4 50
wait 2500
ons 0
wait 2000
expect ons 1 15 17
shot chain2.png
# RESTART ONCE, the cord gone: one hit after PLAY, then nothing
turn K3 -1
wait 60
turn SELECT 1
wait 150
expect page CHAIN START
turn K2 2
wait 60
tap PLAY
wait 200
tap PLAY
ons 0
wait 4000
expect ons 1 1 1
# back to STEPS: the steps play again (none), the graph's slots its own
tap PLAY
turn SELECT 20
wait 150
expect page TRACK
turn K1 -1
wait 100
expect tp 1 SEQMODE 0
