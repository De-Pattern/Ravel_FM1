# The matrix's HITS and ROTATE on a KIT: each lane's hits, as many more or fewer (the steps never change)
wait 300
tap HOME
turn SELECT -20
turn K3 1
wait 100
turn K3 1
wait 200
expect tp 1 KIND 3
clear 1
tap SEQ
wait 200
turn SELECT 6
wait 150
expect page EUCLID
turn K2 1
wait 60
turn K2 1
wait 60
turn K2 1
wait 60
turn K2 1
wait 150
expect steps 1 4
setgp 64 127
tap PLAY
wait 500
ons 0
wait 2000
expect ons 1 3 5
# HITS +8: twelve of sixteen on the lane
setmatq 1 7 1 1 32
wait 300
ons 0
wait 2000
expect ons 1 11 13
expect steps 1 4
# ROTATE: as many
setmatq 1 7 1 2 20
wait 300
ons 0
wait 2000
expect ons 1 3 5
# LENGTH -8 (half the steps, the four hits on 1, 5, 9, 13: two play in each 8)
setmatq 1 7 1 0 -8
wait 300
ons 0
wait 2000
expect ons 1 3 5
expect tp 1 LENGTH 16
# (EUCLID on a cleared kit's lane 3: only its hits, not the other lanes a cleared step's note held)
setmatq 1 0 1 0 0
tap PLAY
clear 1
tap SEQ
wait 150
turn SELECT 6
wait 150
expect page EUCLID
turn K1 2
wait 60
turn K2 1
wait 60
turn K2 1
wait 60
turn K2 1
wait 150
expect steps 1 3
