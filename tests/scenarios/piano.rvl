# PIANO (in HYBRID FM's place): T1 turned to it on SOUND gets its defaults and a piano's track (open, held);
# its pages; FELT PIANO and GRAND sound across the keys; a held note rings, a let-go one is damped, PEDAL holds it
wait 300
tap EDIT
wait 200
expect page SOUND
turn K2 1
wait 80
turn K2 1
wait 120
expect tp 1 ENGINE 2
expect tp 1 FELT 70
expect tp 1 DECAY 75
expect tp 1 SUSTAIN 127
key 12 down
wait 400
expect meter_min 1 0.005
key 12 up
wait 600
turn SELECT 1
wait 200
expect page SOURCE 1
turn SELECT 1
wait 200
expect page SOURCE 2
turn SELECT 1
wait 200
expect page SOURCE 3
preset 1 11
wait 50
expect tp 1 FELT 105
midi 90 15 64
midi 90 30 64
midi 90 3c 64
midi 90 54 64
midi 90 6c 64
wait 1500
expect meter_min 1 0.005
midi 80 15 0
midi 80 30 0
midi 80 3c 0
midi 80 54 0
midi 80 6c 0
wait 1500
preset 1 12
settp 1 PEDAL 0
midi 90 3c 7f
wait 300
midi 80 3c 0
wait 1200
expect meter_max 1 0.002
settp 1 PEDAL 127
midi 90 3c 7f
wait 300
midi 80 3c 0
wait 1200
expect meter_min 1 0.002
